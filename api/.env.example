# Copy to .env for local work. On Railway, set these as service Variables instead (never commit real keys).

# Local: npm run db:dev prints this URL. Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55442/interactive
PORT=3100
# Railway only:
# HOST=0.0.0.0
# REAL_IP_HEADER=x-real-ip

# Front ends allowed to call the API (production). Dev allows every origin.
CORS_ORIGINS=https://santa.inzeniths.com,https://inzeniths.com
# Where the Santa Box pages live (links in emails and after payment)
SANTA_APP_URL=http://localhost:8765

# Files: memory (dev) or r2
STORAGE_DRIVER=memory
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=santa-box

# Payments: fake (dev) or stripe
PAYMENT_DRIVER=fake
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PAYMENT_METHODS=promptpay

# Email: console (dev) or resend
MAIL_DRIVER=console
# MAIL_FROM=Santa Box <hello@inzeniths.com>
# RESEND_API_KEY=re_...

# Clean-up and reminder jobs (keep the API at 1 instance)
JOBS_ENABLED=true
JOB_INTERVAL_MINUTES=60
