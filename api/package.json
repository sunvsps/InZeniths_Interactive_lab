{
  "name": "inzenith-interactive-api",
  "version": "0.1.0",
  "private": true,
  "description": "One back end for every IN ZENITHS interactive campaign (Santa Box first).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "jobs:run": "tsx --env-file-if-exists=.env scripts/run-jobs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "prisma": "^6.19.3",
    "stripe": "^23.1.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "embedded-postgres": "^18.6.0-beta.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
